# Anthropic API key — kept server-side, never sent to the browser
ANTHROPIC_API_KEY=your-anthropic-api-key

# Shared secret included in every Graph change notification.
# Must match the value used when creating the subscription.
# Generate with: python -c "import uuid; print(uuid.uuid4())"
GRAPH_CLIENT_STATE=generate-a-random-uuid-here

# Comma-separated list of allowed CORS origins.
# In Docker the frontend nginx container is the only client, so this is mostly
# for direct browser → backend calls during development.
# Default (dev): http://localhost:5173,http://localhost:4173
# Docker:        http://localhost,http://localhost:80,http://frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
