# Port the frontend is exposed on when running via Docker (default: 80)
FRONTEND_PORT=80

# Microsoft Entra ID app registration credentials
VITE_CLIENT_ID=your-entra-app-client-id
VITE_TENANT_ID=your-tenant-id

# Anthropic API key
# WARNING: For production, proxy Claude API calls through a backend so this key is never exposed client-side.
# For local development, .env with Vite is acceptable.
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key
